# Line endings are normalised to LF everywhere. v1.3.0 shipped with a UTF-8 BOM
# and CRLF drift, which PHP emitted as output ahead of the opening tag and broke
# both plugin activation and the REST API.
* text=auto eol=lf

# Binary files must never be line-ending normalised.
*.png	binary
*.jpg	binary
*.jpeg	binary
*.gif	binary
*.ico	binary
*.zip	binary

# Excluded from `git archive`, which is how the release zip is built.
/README.md		export-ignore
/.gitattributes		export-ignore
/.editorconfig		export-ignore
